---
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	next: Project;
}

const { project, next } = Astro.props;

const links = [
	{ label: 'Voir le site', href: project.liveUrl },
	{ label: 'GitHub', href: project.githubUrl },
	{ label: 'Behance', href: project.behanceUrl },
];
---

<article>
	<!-- Hero -->
	<section class="border-b border-ink/15 px-6 pt-32 pb-16 sm:px-10 sm:pt-40 sm:pb-24 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/60">
			{project.number} — {project.year}
		</p>
		<h1
			data-reveal
			style="--reveal-delay: 100ms"
			class="font-display text-6xl leading-[0.95] font-medium sm:text-8xl lg:text-9xl"
		>
			{project.name}
		</h1>

		<dl
			data-reveal
			style="--reveal-delay: 200ms"
			class="mt-12 grid grid-cols-2 gap-8 border-t border-ink/15 pt-8 sm:grid-cols-4"
		>
			<div>
				<dt class="text-sm uppercase tracking-wide text-ink/50">Rôle</dt>
				<dd class="mt-2 text-base">{project.role}</dd>
			</div>
			<div>
				<dt class="text-sm uppercase tracking-wide text-ink/50">Année</dt>
				<dd class="mt-2 text-base">{project.year}</dd>
			</div>
			<div class="col-span-2">
				<dt class="text-sm uppercase tracking-wide text-ink/50">Technologies</dt>
				<dd class="mt-2 text-base">{project.tech.join(', ')}</dd>
			</div>
		</dl>
	</section>

	<!-- Introduction -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
		<p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
			Introduction
		</p>
		<p
			data-reveal
			style="--reveal-delay: 80ms"
			class="font-display max-w-3xl text-3xl leading-[1.2] font-medium sm:text-5xl lg:text-6xl"
		>
			{project.summary}
		</p>
	</section>

	<!-- Contexte -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">Contexte</p>
		<p class="mb-8 max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
		<div class="grain aspect-[16/9] w-full rounded-sm bg-ink/90" aria-hidden="true"></div>
		<p class="mt-3 text-xs text-ink/40">Image à ajouter — contexte du projet</p>
	</section>

	<!-- Problématique -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Problématique
		</p>
		<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:items-center">
			<div class="grain aspect-[4/3] rounded-sm bg-ink/90" aria-hidden="true"></div>
			{
				project.problem ? (
					<p class="text-lg sm:text-xl">{project.problem}</p>
				) : (
					<p class="border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
						— à compléter —
					</p>
				)
			}
		</div>
	</section>

	<!-- Public cible -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
		<p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
			Public cible
		</p>
		{
			project.audience ? (
				<p
					data-reveal
					style="--reveal-delay: 80ms"
					class="font-display max-w-3xl text-3xl leading-[1.2] font-medium sm:text-5xl lg:text-6xl"
				>
					{project.audience}
				</p>
			) : (
				<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
					— à compléter —
				</p>
			)
		}
	</section>

	<!-- Objectifs -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">Objectifs</p>
		<div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-2">
			<div class="grain aspect-[4/3] rounded-sm bg-ink/90" aria-hidden="true"></div>
			<div class="grain aspect-[4/3] rounded-sm bg-ink/90" aria-hidden="true"></div>
		</div>
		<p class="mt-3 mb-6 text-xs text-ink/40">Images à ajouter — objectifs / vision du projet</p>
		{
			project.objective ? (
				<p class="max-w-2xl text-lg">{project.objective}</p>
			) : (
				<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
					— à compléter —
				</p>
			)
		}
	</section>

	<!-- Recherche UX -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Recherche UX
		</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- Conception -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">Conception</p>
		<div class="grain aspect-[16/9] w-full rounded-sm bg-ink/90" aria-hidden="true"></div>
		<p class="mt-3 mb-6 text-xs text-ink/40">Image à ajouter — wireframes / conception</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- UI Design — mockup plein écran -->
	<section class="border-b border-ink/15 px-6 py-20 sm:px-10 sm:py-28 lg:px-16">
		<p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">UI Design</p>
		<div class="grain flex min-h-[70vh] w-full items-center justify-center rounded-sm bg-ink/90" aria-hidden="true">
			<span class="font-display text-2xl text-bg/30 sm:text-4xl">{project.name}</span>
		</div>
		<p class="mt-3 mb-6 text-xs text-ink/40">Mockup à ajouter — direction artistique / UI</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- Fonctionnalités -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
			Fonctionnalités
		</p>
		<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				project.features.map((feature) => (
					<li class="border border-ink/15 px-5 py-4 text-base">{feature}</li>
				))
			}
		</ul>
	</section>

	<!-- Développement -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Développement
		</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- Technologies -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Technologies
		</p>
		<ul class="flex flex-wrap gap-2">
			{
				project.tech.map((tech) => (
					<li class="rounded-full border border-ink/20 px-4 py-1.5 text-sm">{tech}</li>
				))
			}
		</ul>
	</section>

	<!-- Résultat -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Résultat
		</p>
		<div class="grain aspect-[16/9] w-full rounded-sm bg-ink/90" aria-hidden="true"></div>
		<p class="mt-3 mb-8 text-xs text-ink/40">Image à ajouter — résultat final</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- Ce que j'ai appris -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Ce que j'ai appris
		</p>
		<p class="max-w-2xl border border-dashed border-ink/25 px-5 py-4 text-base text-ink/40 italic">
			— à compléter —
		</p>
	</section>

	<!-- Liens -->
	<section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
		<p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">Liens</p>
		<ul class="flex flex-wrap gap-x-10 gap-y-4">
			{
				links.map((link) =>
					link.href ? (
						<li>
							<a
								href={link.href}
								target="_blank"
								rel="noreferrer"
								class="group relative w-fit text-xl sm:text-2xl"
							>
								{link.label}
								<span class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-ink transition-transform duration-300 group-hover:scale-x-100" />
							</a>
						</li>
					) : (
						<li class="text-xl text-ink/30 sm:text-2xl">{link.label} — à ajouter</li>
					),
				)
			}
		</ul>
	</section>

	<!-- Projet suivant -->
	<section class="px-6 py-24 sm:px-10 sm:py-32 lg:px-16">
		<p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
			Next project
		</p>
		<a
			href={`/projects/${next.slug}`}
			data-cursor="view"
			class="group flex items-end justify-between gap-6"
		>
			<h2 class="font-display text-5xl leading-none transition-transform duration-500 ease-out group-hover:translate-x-3 sm:text-7xl lg:text-8xl">
				{next.name}
			</h2>
			<span
				aria-hidden="true"
				class="mb-2 text-3xl transition-transform duration-300 group-hover:translate-x-2 sm:text-4xl"
			>
				→
			</span>
		</a>
	</section>
</article>
