---
import type { Project } from "../data/projects";
import ProjectImage from "./ProjectImage.astro";

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;

const links = [
  { label: "Voir le site", href: project.liveUrl },
  { label: "GitHub", href: project.githubUrl },
];
---

<article>
  <!-- Hero -->
  <section
    class="border-b border-ink/15 px-6 pt-32 pb-16 sm:px-10 sm:pt-40 sm:pb-24 lg:px-16"
  >
    <p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/60">
      {project.number} — {project.year}
    </p>
    <h1
      data-reveal
      style="--reveal-delay: 100ms"
      class="font-display text-[clamp(2.5rem,12vw,3.75rem)] leading-[0.95] font-medium sm:text-8xl lg:text-9xl"
    >
      {project.name}
    </h1>

    {project.cover && (
      <div class="mt-10 flex aspect-square items-center justify-center overflow-hidden rounded-sm bg-white p-4 sm:mt-12 sm:aspect-[16/9] sm:p-8">
        <img
          src={project.cover}
          alt={`Couverture du projet ${project.name}`}
          loading="eager"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </div>
    )}

    <dl
      data-reveal
      style="--reveal-delay: 200ms"
      class="mt-12 grid grid-cols-2 gap-8 border-t border-ink/15 pt-8 sm:grid-cols-4"
    >
      <div>
        <dt class="text-sm uppercase tracking-wide text-ink/50">Rôle</dt>
        <dd class="mt-2 text-base">{project.role}</dd>
      </div>
      <div>
        <dt class="text-sm uppercase tracking-wide text-ink/50">Année</dt>
        <dd class="mt-2 text-base">{project.year}</dd>
      </div>
      <div class="col-span-2">
        <dt class="text-sm uppercase tracking-wide text-ink/50">
          Technologies
        </dt>
        <dd class="mt-2 text-base">{project.tech.join(", ")}</dd>
      </div>
    </dl>
  </section>

  <!-- Introduction -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
    <p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
      Introduction
    </p>
    <p
      data-reveal
      style="--reveal-delay: 80ms"
      class="max-w-3xl text-lg leading-relaxed text-ink/80 sm:text-xl"
    >
      {project.summary}
    </p>
  </section>

  {
    project.images?.context && (
      <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
        <p
          data-reveal
          class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50"
        >
          Contexte
        </p>
        {project.context && (
          <p class="mb-8 max-w-2xl text-lg sm:text-xl">{project.context}</p>
        )}
        <ProjectImage image={project.images.context} />
      </section>
    )
  }

  <!-- Public cible -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
    <p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
      Public cible
    </p>
    {
      project.audience && (
        <p
          data-reveal
          style="--reveal-delay: 80ms"
          class="max-w-3xl text-lg leading-relaxed text-ink/80 sm:text-xl"
        >
          {project.audience}
        </p>
      )
    }
  </section>

  <!-- Objectifs -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
    <p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
      Objectifs
    </p>
    {
      project.images?.objectives?.length && (
        <div class="mb-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
          {project.images.objectives.map((image) => (
            <ProjectImage image={image} />
          ))}
        </div>
      )
    }
    {project.objective && <p class="max-w-2xl text-lg">{project.objective}</p>}
  </section>

  {
    project.solution && (
      <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
        <p
          data-reveal
          class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50"
        >
          Solution
        </p>
        <p class="max-w-2xl text-lg sm:text-xl">{project.solution}</p>
      </section>
    )
  }

  {
    project.images?.ui?.length && (
      <section class="border-b border-ink/15 px-6 py-20 sm:px-10 sm:py-28 lg:px-16">
        <p
          data-reveal
          class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50"
        >
          Conception des interfaces
        </p>
        <div
          class:list={[
            "mb-6 grid grid-cols-1 gap-8",
            { "sm:grid-cols-2": project.images.ui.length > 1 },
          ]}
        >
          {project.images.ui.map((image) => (
            <ProjectImage image={image} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Fonctionnalités -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
    <p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
      Fonctionnalités
    </p>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        project.features.map((feature) => (
          <li class="border border-ink/15 px-5 py-4 text-base">{feature}</li>
        ))
      }
    </ul>
  </section>

  {
    project.development && (
      <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
        <p
          data-reveal
          class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50"
        >
          Développement
        </p>
        <p class="max-w-2xl text-lg sm:text-xl">{project.development}</p>
      </section>
    )
  }

  <!-- Technologies -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
    <p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
      Technologies
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        project.tech.map((tech) => (
          <li class="rounded-full border border-ink/20 px-4 py-1.5 text-sm">
            {tech}
          </li>
        ))
      }
    </ul>
  </section>

  {
    project.images?.result && (
      <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
        <p
          data-reveal
          class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50"
        >
          Résultat
        </p>
        <div class="mb-8">
          <ProjectImage image={project.images.result} />
        </div>
      </section>
    )
  }

  <!-- Liens -->
  <section class="border-b border-ink/15 px-6 py-16 sm:px-10 sm:py-20 lg:px-16">
    <p data-reveal class="mb-8 text-sm uppercase tracking-[0.2em] text-ink/50">
      Liens
    </p>
    <ul class="flex flex-wrap gap-x-10 gap-y-4">
      {
        links.map((link) =>
          link.href ? (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="group relative w-fit text-xl sm:text-2xl"
              >
                {link.label}
                <span class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-ink transition-transform duration-300 group-hover:scale-x-100" />
              </a>
            </li>
          ) : (
            <li class="text-xl text-ink/30 sm:text-2xl">
              {link.label} — à ajouter
            </li>
          ),
        )
      }
    </ul>
  </section>

  <!-- Projet suivant -->
  <section class="px-6 py-24 sm:px-10 sm:py-32 lg:px-16">
    <p data-reveal class="mb-6 text-sm uppercase tracking-[0.2em] text-ink/50">
      Projet suivant
    </p>
    <a
      href={`/projects/${next.slug}`}
      data-cursor="view"
      class="group flex items-end justify-between gap-3 sm:gap-6"
    >
      <h2
        class="font-display text-4xl leading-none transition-transform duration-500 ease-out group-hover:translate-x-3 sm:text-7xl lg:text-8xl"
      >
        {next.name}
      </h2>
      <span
        aria-hidden="true"
        class="mb-2 text-3xl transition-transform duration-300 group-hover:translate-x-2 sm:text-4xl"
      >
        →
      </span>
    </a>
  </section>
</article>
