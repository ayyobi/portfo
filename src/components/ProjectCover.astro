---
interface Props {
  number: string;
  name: string;
  image?: string;
  images?: string[];
  class?: string;
  tone?: "ink" | "lilac";
}

const {
  number,
  name,
  image,
  images,
  class: className = "",
  tone = "ink",
} = Astro.props;
const isLilac = tone === "lilac";
---

{
  image ? (
    <div class={`flex items-center justify-center gap-3 overflow-hidden bg-white p-4 sm:gap-8 sm:p-8 lg:p-12 ${className}`}>
      {(images?.length ? images : [image]).map((src, index) => (
        <img
          src={src}
          alt={images?.length ? `${name} — aperçu mobile ${index + 1}` : `Présentation du projet ${name}`}
          loading="lazy"
          decoding="async"
          class="h-full min-w-0 flex-1 object-contain"
        />
      ))}
    </div>
  ) : (
    <div
      class={`grain relative flex flex-col justify-between overflow-hidden p-6 ${isLilac ? "bg-lilac" : "bg-ink"} ${className}`}
    >
      <div class="relative z-10 flex justify-end">
        <span
          class={`h-2 w-2 rounded-full ${isLilac ? "bg-ink" : "bg-accent"}`}
        />
      </div>

      <span
        aria-hidden="true"
        class="pointer-events-none absolute right-5 bottom-4 font-display text-[8rem] leading-none font-medium sm:right-8 sm:bottom-6 sm:text-[11rem]"
        style={`-webkit-text-stroke: 1px color-mix(in srgb, var(${isLilac ? "--color-ink" : "--color-bg"}) 65%, transparent); color: transparent;`}
      >
        {number}
      </span>
    </div>
  )
}
