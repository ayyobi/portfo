---
// Accueil : le nom animé, les rôles qui défilent, et à droite la boucle `while (alive)` qui s'écrit.
const cv = `${import.meta.env.BASE_URL}Nargis-AYYOBI-CV.pdf`;
const loop = 'while (alive) {\n  eat();\n  sleep();\n  code();\n  repeat();\n}';
// le nom lettre par lettre : les « i » ont une tache-œil à la place du point
const lines = ['Nargis', 'Ayyobi'];
// les rôles qui défilent sous le nom
const roles = ['conceptrice numérique', 'designer UI/UX', 'créative du code'];
---

<section class="hero px-6 pt-32 pb-16 sm:px-10 lg:px-20">
	<div class="grid items-center gap-12 lg:grid-cols-[1fr_minmax(0,560px)]">
		<div class="min-w-0">
			<h1
				class="name font-sans text-6xl leading-[1.05] font-bold tracking-tight sm:text-7xl lg:text-[80px]"
				aria-label="Nargis Ayyobi"
				data-name
			>
				{lines.map((word) => (
					<span class="word" aria-hidden="true">
						{[...word].map((ch) =>
							ch === 'i' ? (
								<span class="ch i">
									ı<i class="eye" data-eye />
								</span>
							) : (
								<span class="ch">{ch}</span>
							),
						)}
					</span>
				))}
			</h1>
			<p class="mt-8 text-xl leading-snug">
				Développeuse web
				<br />
				&amp;{' '}
				<span class="role" data-roles={JSON.stringify(roles)}>
					{roles[0]}
				</span>
				<span class="caret" aria-hidden="true"></span>
			</p>
			<p class="mt-6 max-w-[34rem] text-xl leading-snug">
				Je conçois et développe des expériences web{' '}
				<span class="kw kw-ink" data-kw="ink">
					créatives
				</span>
				,{' '}
				<span class="kw kw-line" data-kw="line">
					accessibles
				</span>{' '}
				et{' '}
				<span class="kw kw-jump" data-kw="jump">
					interactives
				</span>
				.
			</p>
			<p class="pill mt-14" data-magnet>
				<i class="live" aria-hidden="true"></i>Alternance ou stage de 2 mois · dès fin mars
			</p>
			<a
				href="#work"
				class="discover group mt-6 flex w-fit items-center gap-2 py-1 font-mono text-sm tracking-[0.12em] text-muted uppercase"
			>
				<span data-scramble>Découvrir mes projets</span>
				<span aria-hidden="true" class="arrow">
					↓
				</span>
			</a>
		</div>

		<div class="min-w-0">
			<div class="loop" data-loop>
				<div class="loop-bar">
					<span class="dots" aria-hidden="true">
						<i></i>
						<i></i>
						<i></i>
					</span>
					<span class="file" aria-hidden="true">
						life.js
					</span>
					<span class="day" data-day aria-hidden="true">
						jour 1
					</span>
					<button type="button" class="pp" data-pp aria-label="Mettre la boucle en pause" hidden>
						❚❚
					</button>
				</div>
				<pre
					class="loop-code"
					role="img"
					aria-label={loop}
				><code aria-hidden="true" data-loop-code>{loop}</code><span class="cur" aria-hidden="true"></span></pre>
				<p class="term" aria-hidden="true">
					<span class="pr">$</span> <span data-out>node life.js</span>
				</p>
			</div>

			<div class="mt-8 flex justify-center">
				<a href={cv} target="_blank" rel="noreferrer" class="cv-btn">
					Télécharger mon CV <span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.name {
		cursor: default;
	}
	.word {
		display: block;
		white-space: nowrap;
	}
	.ch {
		display: inline-block;
		font-variation-settings: 'wght' var(--w, 700);
		font-weight: normal;
		will-change: transform;
	}
	.ch.i {
		position: relative;
	}
	.eye {
		position: absolute;
		left: 50%;
		top: -0.02em;
		width: 0.24em;
		height: 0.3em;
		margin-left: -0.12em;
		border-radius: 50%;
		background: var(--color-ink);
		rotate: -28deg;
	}
	.role {
		font-family: var(--font-mono);
		font-size: 0.92em;
	}
	.caret {
		display: inline-block;
		width: 0.5em;
		height: 0.22em;
		margin-left: 0.15em;
		border-radius: 50%;
		background: var(--color-ink);
		vertical-align: 0.05em;
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.kw {
		position: relative;
		display: inline-block;
		isolation: isolate;
		cursor: default;
	}
	.kw-ink::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -0.05em -0.3em;
		border-radius: 46% 54% 42% 58% / 60% 44% 56% 40%;
		background: var(--color-ink);
		transform: scale(0);
		transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
	}
	.kw-ink:hover {
		color: var(--color-bg);
	}
	.kw-ink:hover::before {
		transform: scale(1) rotate(-3deg);
	}
	.kw-line::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.05em;
		height: 3px;
		background: var(--color-sage);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s;
	}
	.kw-line:hover::after {
		transform: scaleX(1);
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		border-radius: 999px;
		background: var(--color-sage);
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
		cursor: default;
	}
	.live {
		position: relative;
		width: 9px;
		height: 11px;
		border-radius: 50%;
		background: var(--color-ink);
		rotate: -28deg;
	}
	.live::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--color-ink);
		animation: pulse 1.8s ease-out infinite;
	}
	@keyframes pulse {
		to {
			transform: scale(2.6);
			opacity: 0;
		}
	}
	.arrow {
		display: inline-block;
		animation: bounce 1.6s ease-in-out infinite;
	}
	@keyframes bounce {
		50% {
			transform: translateY(4px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.caret,
		.live::after,
		.arrow {
			animation: none;
		}
	}
	.loop {
		max-width: 22rem;
		margin: 1.5rem auto 0;
		overflow: hidden;
		border-radius: 12px;
		background: var(--color-ink);
		color: var(--color-bg);
	}
	.loop-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0.9rem;
		background: var(--color-ink-2);
	}
	.dots {
		display: flex;
		gap: 6px;
	}
	.file {
		font: 0.72rem var(--font-mono);
		color: var(--color-code-light);
	}
	.day {
		margin-left: auto;
		font: 0.72rem var(--font-mono);
		color: var(--color-sage);
	}
	.pp {
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		font-size: 0.55rem;
		color: var(--color-ink);
		background: var(--color-yellow);
		cursor: pointer;
	}
	.pp:focus-visible {
		outline: 2px solid var(--color-bg);
		outline-offset: 2px;
	}
	/* la ligne en cours d'exécution, comme dans un débogueur */
	.loop :global(.ln) {
		position: relative;
		display: block;
		margin: 0 -1.5rem;
		padding: 0 1.5rem;
		transition: background 0.3s;
	}
	.loop :global(.ln.on) {
		background: rgb(165 174 139 / 0.16);
	}
	.loop :global(.ln.on)::before {
		content: '▸';
		position: absolute;
		left: 0.5rem;
		color: var(--color-sage);
	}
	.loop.asleep .loop-code {
		opacity: 0.45;
		transition: opacity 0.6s;
	}
	.loop-code {
		position: relative;
		transition: opacity 0.6s;
	}
	/* les « z » qui s'envolent pendant sleep() */
	.loop :global(.z) {
		position: absolute;
		font: 600 0.9rem var(--font-mono);
		color: var(--color-sage);
		pointer-events: none;
		animation: z 1.6s ease-out forwards;
	}
	@keyframes z {
		from {
			opacity: 0;
			transform: translate(0, 0) scale(0.6);
		}
		25% {
			opacity: 1;
		}
		to {
			opacity: 0;
			transform: translate(26px, -46px) scale(1.3) rotate(12deg);
		}
	}
	.term {
		min-height: 2.6rem;
		border-top: 1px solid var(--color-line);
		padding: 0.7rem 1.5rem;
		font: 0.78rem var(--font-mono);
		color: #cfcac2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.term .pr {
		color: var(--color-sage);
	}
	.loop-bar i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-code);
	}
	.loop-bar i:nth-child(2) {
		background: var(--color-bg);
	}
	.loop-code {
		padding: 1.25rem 1.5rem 1.5rem;
		font: 0.85rem/2.3 var(--font-mono);
		white-space: pre;
	}
	.cur {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-left: 0.15em;
		vertical-align: -0.2em;
		background: var(--color-sage);
		animation: cur 1s steps(1) infinite;
	}
	@keyframes cur {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cur {
			animation: none;
		}
	}
	.cv-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		border: 1.5px solid var(--color-ink);
		border-radius: 999px;
		padding: 0.8rem 1.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition:
			background 0.2s,
			color 0.2s;
	}
	.cv-btn:hover {
		background: var(--color-ink);
		color: var(--color-bg);
	}
	a:focus-visible {
		outline: 2px solid var(--color-ink);
		outline-offset: 4px;
	}
</style>

<script src="../../scripts/home/hero.ts"></script>
