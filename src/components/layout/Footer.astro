---
// Pied de page « flaque d'encre » : quand on arrive en bas, l'encre monte en vague ;
// la souris (ou le doigt) y fait des ondulations. Le texte reste du vrai HTML par-dessus.
---

<footer class="foot" data-ink-footer>
	<canvas class="ink" aria-hidden="true"></canvas>
	<div class="content">
		<p class="name">Nargis Ayyobi © 2026</p>
		<p class="commit">git commit -m "merci pour votre visite"</p>
		<a href="/mentions-legales" class="legal">
			Mentions légales
		</a>
	</div>
</footer>

<style>
	.foot {
		position: relative;
		height: 17rem;
		overflow: hidden;
		background: var(--color-bg);
		cursor: crosshair;
		touch-action: pan-y;
	}
	.ink {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.content {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1.75rem;
		text-align: center;
		color: var(--color-bg);
		pointer-events: none;
	}
	/* sur téléphone, le texte remonte pour ne pas passer sous le bouton panda « retour en haut » */
	@media (max-width: 640px) {
		.foot {
			height: 20rem;
		}
		.content {
			bottom: 6.5rem;
		}
	}
	.name {
		font-size: clamp(1.25rem, 3vw, 1.75rem);
	}
	.commit {
		margin-top: 0.4rem;
		font: 0.8rem var(--font-mono);
		color: var(--color-sage);
	}
	.legal {
		display: inline-block;
		margin-top: 0.5rem;
		padding-block: 0.25rem;
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 3px;
		pointer-events: auto;
	}
	.legal:hover {
		color: var(--color-yellow);
	}
	.legal:focus-visible {
		outline: 2px solid var(--color-yellow);
		outline-offset: 3px;
	}
</style>

<script src="../../scripts/layout/footer.ts"></script>
