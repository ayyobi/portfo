---
// Écran de chargement : le logo s'écrit, des gouttes d'encre deviennent les points des « ı »,
// le terminal charge les projets, puis la tache-curseur envahit l'écran et se retire.
// Affiché une seule fois par session, jamais si l'animation est réduite.
---

<script is:inline>
	try {
		if (!sessionStorage.getItem('nargis-loaded') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
			document.documentElement.classList.add('is-loading');
		}
	} catch (e) {}
</script>

<div class="loader" data-loader role="status" aria-live="polite">
	<span class="sr-only">Chargement du portfolio</span>
	<div class="stage" aria-hidden="true">
		<p class="logo" data-logo></p>
		<p class="term">
			<span class="prompt">$</span> <span data-term></span>
		</p>
		<div class="bar">
			<i data-bar></i>
		</div>
	</div>
	<i class="blob" data-blob aria-hidden="true"></i>
	<button type="button" class="skip" data-skip>
		passer →
	</button>
</div>

<style>
	.loader {
		display: none;
	}
	:global(html.is-loading) .loader {
		display: block;
		position: fixed;
		inset: 0;
		z-index: 200;
		background: var(--color-bg);
		color: var(--color-ink);
	}
	:global(html.is-loading) body {
		overflow: hidden;
	}
	.loader.bg-off {
		display: block;
		position: fixed;
		inset: 0;
		z-index: 200;
		background: transparent;
		pointer-events: none;
	}
	.loader.bg-off .skip {
		display: none;
	}
	.stage {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		transition: opacity 0.25s;
	}
	.logo {
		position: relative;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: clamp(2.2rem, 7vw, 4.5rem);
		line-height: 1;
		letter-spacing: -0.02em;
		min-height: 1.1em;
		white-space: nowrap;
	}
	.logo :global(.i) {
		position: relative;
		display: inline-block;
	}
	.logo :global(.drop) {
		position: absolute;
		left: 50%;
		top: -0.12em;
		width: 0.17em;
		height: 0.22em;
		margin-left: -0.085em;
		border-radius: 50%;
		background: var(--color-ink);
		transform: translateY(-60vh) rotate(-28deg) scaleY(1.6);
		animation:
			fall 0.55s cubic-bezier(0.55, 0, 0.75, 0.2) forwards,
			splat 0.35s 0.55s ease-out forwards;
	}
	.logo :global(.drop.blink) {
		animation: blink-eye 0.28s ease-in-out;
		transform: rotate(-28deg);
	}
	@keyframes fall {
		to {
			transform: translateY(0) rotate(-28deg) scaleY(1.6);
		}
	}
	@keyframes splat {
		0% {
			transform: rotate(-28deg) scale(1.5, 0.6);
		}
		60% {
			transform: rotate(-28deg) scale(0.9, 1.15);
		}
		100% {
			transform: rotate(-28deg) scale(1);
		}
	}
	@keyframes blink-eye {
		50% {
			transform: rotate(-28deg) scaleY(0.12);
		}
	}
	.logo :global(.caret) {
		display: inline-block;
		width: 0.32em;
		height: 0.16em;
		margin-left: 0.06em;
		border-radius: 50%;
		background: var(--color-ink);
		transform: rotate(-12deg);
		animation: caret 1s steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	.term {
		font: 0.85rem/1.4 var(--font-mono);
		color: var(--color-muted);
		min-height: 1.4em;
	}
	.prompt {
		color: var(--color-sage);
	}
	.term :global(.ok) {
		color: var(--color-ink);
	}
	.bar {
		width: min(260px, 60vw);
		height: 6px;
		border-radius: 999px;
		background: var(--color-beige);
		overflow: hidden;
	}
	.bar i {
		display: block;
		height: 100%;
		width: 0;
		border-radius: inherit;
		background: var(--color-ink);
		transition: width 0.3s ease;
	}
	.blob {
		position: fixed;
		width: 40px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-ink);
		opacity: 0;
		transform: translate(-50%, -50%) rotate(-12deg) scale(1);
		pointer-events: none;
	}
	.blob.grow {
		opacity: 1;
		transition: transform 0.75s cubic-bezier(0.7, 0, 0.2, 1);
	}
	.blob.shrink {
		transition:
			transform 0.7s cubic-bezier(0.7, 0, 0.2, 1),
			border-radius 0.7s;
	}
	.skip {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		font:
			0.8rem ui-monospace,
			Menlo,
			monospace;
		color: var(--color-muted);
	}
	.skip:hover,
	.skip:focus-visible {
		color: var(--color-ink);
		text-decoration: underline;
	}
</style>

<script is:inline>
	(() => {
		const root = document.documentElement;
		const el = document.querySelector('[data-loader]');
		if (!el || !root.classList.contains('is-loading')) return;

		const logo = el.querySelector('[data-logo]');
		const term = el.querySelector('[data-term]');
		const bar = el.querySelector('[data-bar]');
		const blob = el.querySelector('[data-blob]');
		const stage = el.querySelector('.stage');
		const wait = (ms) => new Promise((r) => setTimeout(r, ms));
		let done = false;

		const finish = () => {
			if (done) return;
			done = true;
			try {
				sessionStorage.setItem('nargis-loaded', '1');
			} catch (e) {}
			root.classList.remove('is-loading');
			el.remove();
		};
		el.querySelector('[data-skip]').addEventListener('click', finish);
		setTimeout(finish, 6000); // sécurité

		const typeTerm = async (html, text) => {
			term.innerHTML = html;
			for (const ch of text) {
				if (done) return;
				term.innerHTML += ch;
				await wait(18);
			}
		};

		(async () => {
			await wait(150);
			const word = 'nargıs.ayyobı';
			const drops = [];
			typeTerm('', 'npm run portfolio');
			for (let k = 0; k < word.length; k++) {
				if (done) return;
				const ch = word[k];
				const span = document.createElement('span');
				span.textContent = ch;
				if (ch === 'ı') {
					span.className = 'i';
					const d = document.createElement('i');
					d.className = 'drop';
					span.appendChild(d);
					drops.push(d);
				}
				logo.appendChild(span);
				bar.style.width = `${Math.round(((k + 1) / word.length) * 70)}%`;
				await wait(ch === '.' ? 160 : 85);
			}
			const caret = document.createElement('span');
			caret.className = 'caret';
			logo.appendChild(caret);

			const steps = ['zozzo ', 'washroll ', 'olyvia '];
			let html = '';
			for (let s = 0; s < steps.length; s++) {
				if (done) return;
				await typeTerm(html, steps[s]);
				html = term.innerHTML + '<span class="ok">✓</span> ';
				term.innerHTML = html;
				bar.style.width = `${70 + (s + 1) * 10}%`;
			}

			// les deux points des « ı » clignent comme des yeux de panda
			drops.forEach((d) => {
				d.style.animation = 'none';
				d.style.transform = 'rotate(-28deg)';
			});
			await wait(120);
			drops.forEach((d) => d.classList.add('blink'));
			await wait(380);
			if (done) return;

			// la tache-curseur envahit l'écran…
			const r = caret.getBoundingClientRect();
			blob.style.left = `${r.left + r.width / 2}px`;
			blob.style.top = `${r.top + r.height / 2}px`;
			const cover = (Math.hypot(innerWidth, innerHeight) * 2) / 22;
			blob.classList.add('grow');
			requestAnimationFrame(() => {
				blob.style.transform = `translate(-50%, -50%) rotate(-12deg) scale(${cover})`;
			});
			await wait(780);
			if (done) return;

			// …puis se retire et laisse apparaître le site
			stage.style.opacity = '0';
			el.classList.add('bg-off');
			root.classList.remove('is-loading');
			blob.classList.add('shrink');
			blob.style.transform = 'translate(-50%, -50%) rotate(-12deg) scale(0)';
			await wait(720);
			finish();
		})();
	})();
</script>
