---
// Logo « nargıs.ayyobı » : les points des « ı » sont deux taches-yeux (elles clignent),
// le point du milieu est le nez, et une tache-curseur clignote à la fin.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]} role="img" aria-label="nargis.ayyobi">
	<span aria-hidden="true">
		narg
		<span class="i">
			ı<i class="eye"></i>
		</span>
		s<span class="nose">.</span>ayyob
		<span class="i">
			ı<i class="eye r"></i>
		</span>
		<i class="caret"></i>
	</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: baseline;
		font-family: var(--font-mono);
		font-weight: 500;
		letter-spacing: -0.01em;
		white-space: nowrap;
		line-height: 1;
	}
	.i {
		position: relative;
		display: inline-block;
	}
	.eye {
		position: absolute;
		left: 50%;
		top: -0.3em;
		width: 0.36em;
		height: 0.46em;
		margin-left: -0.18em;
		border-radius: 50%;
		background: currentColor;
		transform: rotate(-28deg);
		animation: blink 5s infinite;
	}
	.eye.r {
		transform: rotate(28deg);
	}
	.nose {
		display: inline-block;
		transform: scale(1.35);
	}
	.caret {
		display: inline-block;
		width: 0.62em;
		height: 0.3em;
		margin-left: 0.08em;
		border-radius: 50%;
		background: currentColor;
		transform: rotate(-10deg);
		animation: caret 1.1s steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	@keyframes blink {
		0%,
		92%,
		100% {
			scale: 1 1;
		}
		95% {
			scale: 1 0.1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.eye,
		.caret {
			animation: none;
		}
	}
</style>
