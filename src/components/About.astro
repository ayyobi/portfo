---
// À propos : le texte est écrit en crème sur un papier crème, donc invisible.
// On peint à l'encre avec la souris pour le lire ; « Tout révéler » remplit tout le papier
// (accessibilité, clavier). Sur écran tactile, l'encre se répand toute seule.
---

<section id="about" class="bg-ink px-6 py-24 text-bg sm:px-10 lg:px-20">
	<h2 data-split="words" class="mb-10 font-sans text-sm tracking-[0.12em] text-sage uppercase">À propos de moi</h2>

	<div class="paper" data-paper>
		<canvas class="ink" aria-hidden="true"></canvas>
		<p class="txt">
			Je m’appelle Nargis. Née en Iran, j’ai grandi en Afghanistan, et j’étudie aujourd’hui en BUT MMI à
			Montbéliard. Je conçois et je code des interfaces, de la première idée jusqu’à la dernière ligne de CSS.
			J’aime quand un détail bien pensé rend un site plus simple pour tout le monde.
		</p>
		<p class="seek">// je cherche : alternance, ou stage de 2 mois dès fin mars</p>
		<div class="row">
			<button type="button" class="reveal" data-reveal-all>Tout révéler</button>
			<span class="hint" aria-hidden="true">// peins avec la souris pour lire</span>
		</div>
	</div>

	<div data-reveal class="diff">
		<p class="name">ma-vision-de-l-ia.diff</p>
		<p class="del"><span aria-hidden="true">- </span><del>L’IA code à ma place.</del></p>
		<p class="add"><span aria-hidden="true">+ </span>L’IA m’aide à explorer des idées et à aller plus vite.</p>
		<p class="add"><span aria-hidden="true">+ </span>Mais chaque ligne, je la comprends, je la teste et je la vérifie.</p>
	</div>
</section>

<style>
	.paper {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		background: var(--color-bg);
		padding: 2.5rem 2.5rem 1.25rem;
		cursor: crosshair;
		touch-action: pan-y;
	}
	.ink {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.txt {
		position: relative;
		max-width: 62rem;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.4vw, 2rem);
		line-height: 1.45;
		color: var(--color-bg);
		pointer-events: none;
	}
	.paper.all .txt,
	.paper.all .seek {
		transition: color 0.6s;
	}
	.seek {
		position: relative;
		margin-top: 2.5rem;
		font: 0.95rem var(--font-mono);
		color: var(--color-sage);
		pointer-events: none;
	}
	.row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
	}
	.reveal {
		border: 1.5px solid var(--color-ink);
		border-radius: 999px;
		padding: 0.55rem 1rem;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-ink);
		background: var(--color-bg);
		cursor: pointer;
	}
	.reveal:hover {
		background: var(--color-ink);
		color: var(--color-bg);
	}
	.reveal:focus-visible {
		outline: 2px solid var(--color-yellow);
		outline-offset: 3px;
	}
	.hint {
		font: 0.8rem var(--font-mono);
		color: var(--color-muted);
	}
	.paper.all .hint,
	.paper.all .reveal {
		visibility: hidden;
	}
	.diff {
		margin-top: 2rem;
		max-width: 36rem;
		border-radius: 10px;
		background: var(--color-ink-2);
		padding: 1rem 1.25rem;
		font: 0.95rem/1.7 var(--font-mono);
	}
	.diff .name {
		font-size: 0.75rem;
		color: #aaa69f;
		margin-bottom: 0.25rem;
	}
	.del {
		color: #8a867f;
	}
	.add {
		color: var(--color-sage);
	}
</style>

<script>
	const paper = document.querySelector<HTMLElement>('[data-paper]');
	if (paper) {
		const canvas = paper.querySelector('canvas')!;
		const ctx = canvas.getContext('2d')!;
		const btn = paper.querySelector<HTMLButtonElement>('[data-reveal-all]')!;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const INK = '#111111';

		const size = () => {
			const r = paper.getBoundingClientRect();
			const dpr = Math.min(2, devicePixelRatio || 1);
			const prev = canvas.width ? ctx.getImageData(0, 0, canvas.width, canvas.height) : null;
			canvas.width = r.width * dpr;
			canvas.height = r.height * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			if (prev) ctx.putImageData(prev, 0, 0);
		};
		size();
		new ResizeObserver(size).observe(paper);

		// une tache d'encre irrégulière : plusieurs cercles + quelques éclaboussures
		const blot = (x: number, y: number, r: number) => {
			ctx.fillStyle = INK;
			ctx.beginPath();
			for (let i = 0; i < 6; i++) {
				const a = Math.random() * Math.PI * 2, d = Math.random() * r * 0.45;
				ctx.moveTo(x + Math.cos(a) * d + r * 0.7, y + Math.sin(a) * d);
				ctx.ellipse(x + Math.cos(a) * d, y + Math.sin(a) * d, r * (0.55 + Math.random() * 0.3), r * (0.45 + Math.random() * 0.3), Math.random() * 3, 0, Math.PI * 2);
			}
			ctx.fill();
			if (Math.random() < 0.25) {
				const a = Math.random() * Math.PI * 2, d = r * (1.3 + Math.random());
				ctx.beginPath();
				ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, 2 + Math.random() * 4, 0, Math.PI * 2);
				ctx.fill();
			}
		};

		let last: [number, number] | null = null;
		paper.addEventListener('pointermove', (e) => {
			if (e.pointerType === 'touch') return;
			if ((e.target as HTMLElement).closest('button')) return;
			const r = paper.getBoundingClientRect();
			const x = e.clientX - r.left, y = e.clientY - r.top;
			if (last) {
				const d = Math.hypot(x - last[0], y - last[1]);
				const steps = Math.ceil(d / 14);
				for (let i = 1; i <= steps; i++) blot(last[0] + ((x - last[0]) * i) / steps, last[1] + ((y - last[1]) * i) / steps, 26 + Math.min(18, d / 4));
			}
			last = [x, y];
		});
		paper.addEventListener('pointerleave', () => (last = null));

		// tout révéler : l'encre remplit le papier
		const fillAll = () => {
			size();
			paper.classList.add('all');
			btn.disabled = true;
			if (reduce) {
				ctx.fillStyle = INK;
				ctx.fillRect(0, 0, canvas.width, canvas.height);
				paper.style.background = INK;
				return;
			}
			const r = paper.getBoundingClientRect();
			let n = 0;
			const tick = () => {
				for (let i = 0; i < 14; i++) blot(Math.random() * r.width, Math.random() * r.height, 40 + n * 2);
				if (++n < 40) requestAnimationFrame(tick);
				else { ctx.fillStyle = INK; ctx.fillRect(0, 0, canvas.width, canvas.height); paper.style.background = INK; }
			};
			tick();
		};
		btn.addEventListener('click', fillAll);

		// écran tactile ou animations réduites : le texte se révèle tout seul
		if (reduce || !matchMedia('(pointer: fine)').matches) {
			const io = new IntersectionObserver(([e]) => {
				if (e.isIntersecting) { io.disconnect(); fillAll(); }
			}, { threshold: 0.5 });
			io.observe(paper);
		}
	}
</script>
