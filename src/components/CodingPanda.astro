		</g>
		<!-- Coffee break -->
		<path d="M103 362H93V384Q93 391 101 391H113Q121 391 121 383V362Z" fill="#fff" stroke="currentColor" stroke-width="2.5" />
		<path d="M122 366H127C137 366 137 381 122 381" stroke="currentColor" stroke-width="2.5" />
		<path class="coffee-steam" d="M104 351C95 342 113 338 104 330" stroke="currentColor" stroke-opacity=".3" stroke-width="2" stroke-linecap="round" />
	</svg>
	<button type="button" class="animation-toggle" aria-label="Mettre l’animation du panda en pause" aria-pressed="false" hidden>
		<span class="pause-icon" aria-hidden="true">Ⅱ</span>
		<span class="play-icon" aria-hidden="true">▷</span>
	</button>
</div>

<style>
	.coding-panda { position: relative; width: 100%; color: var(--color-ink); }
	svg { display: block; width: 100%; height: auto; overflow: visible; }
	.panda-head { transform-origin: 220px 275px; animation: nod 3.2s ease-in-out infinite; }
	.panda-eyes { transform-box: fill-box; transform-origin: center; animation: blink 5.2s infinite; }
	.panda-paw { animation: typing .48s ease-in-out infinite alternate; }
	.paw-left { transform-origin: 155px 294px; }
	.paw-right { transform-origin: 292px 294px; animation-delay: -.48s; }
	.coffee-steam { animation: steam 3s ease-in-out infinite; }
	.animation-toggle { position: absolute; right: 8%; bottom: 0; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: 50%; background: transparent; color: inherit; cursor: pointer; opacity: .55; }
	.animation-toggle[hidden] { display: none; }
	.animation-toggle:hover, .animation-toggle:focus-visible { opacity: 1; }
	.animation-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
	.play-icon, .is-paused .pause-icon { display: none; }
	.is-paused .play-icon { display: inline; }
	.is-paused svg * { animation-play-state: paused; }
	@keyframes nod { 0%, 100% { transform: rotate(-2deg) translateY(0); } 50% { transform: rotate(2deg) translateY(4px); } }
	@keyframes blink { 0%, 43%, 47%, 100% { transform: scaleY(1); } 45% { transform: scaleY(.08); } }
	@keyframes typing { from { transform: rotate(-3deg) translateY(-3px); } to { transform: rotate(2deg) translateY(2px); } }
	@keyframes steam { 0%, 100% { transform: translateY(2px); opacity: .3; } 50% { transform: translateY(-5px); opacity: .8; } }
	@media (prefers-reduced-motion: reduce) {
		svg * { animation: none !important; }
		.animation-toggle { display: none; }
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.coding-panda').forEach((panda) => {
		const toggle = panda.querySelector<HTMLButtonElement>('.animation-toggle');
		if (!toggle) return;
		toggle.hidden = false;
		toggle.addEventListener('click', () => {
			const paused = panda.classList.toggle('is-paused');
			toggle.setAttribute('aria-pressed', String(paused));
			toggle.setAttribute('aria-label', paused ? 'Reprendre l’animation du panda' : 'Mettre l’animation du panda en pause');
		});
	});
</script>
