<div class="coding-panda">
	<svg viewBox="0 0 600 480" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="coding-panda-title">
		<title id="coding-panda-title">Un panda noir et blanc avec des lunettes rondes, assis sur une chaise de bureau, tape du code sur le clavier de son ordinateur.</title>
		<!-- A quiet desk scene, drawn in the same ink as the portfolio. -->
		<ellipse cx="312" cy="425" rx="228" ry="16" fill="currentColor" opacity=".055" />
		<!-- Chair behind the panda, with its seat and wheels visible below the desk. -->
		<g class="panda-chair">
			<rect x="105" y="257" width="231" height="130" rx="32" fill="#fff" stroke="currentColor" stroke-width="3.5" />
			<rect x="114" y="266" width="213" height="111" rx="25" stroke="currentColor" stroke-opacity=".18" stroke-width="2" />
			<path d="M120 373V401M322 373V401" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
			<rect x="109" y="396" width="226" height="16" rx="8" fill="#fff" stroke="currentColor" stroke-width="3.5" />
			<path d="M222 415V438" stroke="currentColor" stroke-width="9" stroke-linecap="round" />
			<path d="M164 450L222 436L280 450M222 438V454" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
			<rect x="154" y="448" width="18" height="11" rx="5" fill="currentColor" />
			<rect x="272" y="448" width="18" height="11" rx="5" fill="currentColor" />
			<rect x="214" y="451" width="16" height="11" rx="5" fill="currentColor" />
		</g>
		<path d="M80 396H558" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
		<path d="M126 398V435M514 398V435" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
		<!-- Body and feet -->
		<ellipse cx="223" cy="328" rx="96" ry="79" fill="currentColor" />
		<ellipse cx="226" cy="322" rx="66" ry="72" fill="#fff" stroke="currentColor" stroke-width="3" />
		<ellipse cx="162" cy="385" rx="42" ry="16" fill="currentColor" />
		<ellipse cx="282" cy="385" rx="39" ry="16" fill="currentColor" />
		<g class="panda-head">
			<circle cx="144" cy="132" r="37" fill="currentColor" />
			<circle cx="291" cy="132" r="37" fill="currentColor" />
			<circle cx="144" cy="132" r="19" fill="#fff" opacity=".16" />
			<circle cx="291" cy="132" r="19" fill="#fff" opacity=".16" />
			<path d="M113 203C113 135 154 111 217 111C280 111 325 147 325 207C325 262 280 288 218 288C157 288 113 260 113 203Z" fill="#fff" stroke="currentColor" stroke-width="3.5" />
			<ellipse cx="172" cy="204" rx="28" ry="35" transform="rotate(27 172 204)" fill="currentColor" />
			<ellipse cx="270" cy="204" rx="28" ry="35" transform="rotate(-27 270 204)" fill="currentColor" />
			<g class="panda-eyes">
				<ellipse cx="181" cy="206" rx="10" ry="12" fill="#fff" />
				<ellipse cx="276" cy="206" rx="10" ry="12" fill="#fff" />
				<ellipse cx="184" cy="209" rx="5" ry="7" fill="currentColor" />
				<ellipse cx="279" cy="209" rx="5" ry="7" fill="currentColor" />
				<circle cx="185" cy="206" r="2" fill="#fff" />
				<circle cx="280" cy="206" r="2" fill="#fff" />
			</g>
			<g class="panda-glasses" stroke="currentColor" stroke-width="4" stroke-linecap="round">
				<path d="M135 195L116 187M310 195L323 187M211 202Q223 191 235 202" />
				<circle cx="175" cy="204" r="37" stroke="#fff" stroke-width="7" />
				<circle cx="273" cy="204" r="37" stroke="#fff" stroke-width="7" />
				<circle cx="175" cy="204" r="37" />
				<circle cx="273" cy="204" r="37" />
				<path d="M151 190L161 180M249 190L259 180" stroke="#fff" stroke-opacity=".65" stroke-width="3" />
			</g>
			<path d="M209 235C209 226 236 226 236 235C236 241 228 247 223 247C217 247 209 241 209 235Z" fill="currentColor" />
			<path d="M223 245V252M223 252Q210 266 201 253M223 252Q234 265 245 253" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
			<path d="M143 240L154 243M290 243L301 240" stroke="currentColor" stroke-opacity=".18" stroke-width="4" stroke-linecap="round" />
		</g>
		<!-- Paws type on the laptop keyboard behind its lid. -->
		<g class="panda-paw paw-left">
			<path d="M151 284C128 294 140 328 161 345L220 374C245 384 264 361 243 347L190 314C181 293 168 278 151 284Z" fill="currentColor" />
			<path d="M224 357L233 364M215 363L224 369" stroke="#fff" stroke-opacity=".5" stroke-width="2" stroke-linecap="round" />
		</g>
		<g class="panda-paw paw-right">
			<path d="M288 281C311 278 323 301 318 325L308 345C342 353 348 376 326 379C310 381 281 365 278 351C275 336 279 311 275 301Z" fill="currentColor" />
			<path d="M323 362L332 368M315 367L324 374" stroke="#fff" stroke-opacity=".5" stroke-width="2" stroke-linecap="round" />
		</g>
		<!-- The laptop faces the panda; its lid sits in front of the typing paws. -->
		<g class="panda-laptop">
			<!-- Straight, symmetrical display with a visible hinge. -->
			<rect x="177" y="281" width="196" height="98" rx="7" fill="currentColor" stroke="currentColor" stroke-width="3.5" />
			<rect x="181" y="285" width="188" height="90" rx="4" fill="#fff" />
			<path d="M188 291H362" stroke="currentColor" stroke-opacity=".12" stroke-width="2" stroke-linecap="round" />
			<g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
				<path d="M261 318L250 328L261 338M285 318L296 328L285 338M278 315L268 341" />
			</g>
			<path d="M177 379H373L389 389H161Z" fill="#fff" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
			<path d="M161 389H389V392Q389 396 381 396H169Q161 396 161 392Z" fill="#fff" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
			<path d="M187 379H363" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
