---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section id="work" class="px-6 py-24 sm:px-10 sm:py-32 lg:px-16">
	<div data-reveal class="mb-16 sm:mb-24">
		<h2 class="font-display text-5xl leading-none sm:text-7xl lg:text-8xl">
			Selected
			<br />
			Work
		</h2>
	</div>

	<ul>
		{projects.map((project, index) => <ProjectCard project={project} index={index} />)}
	</ul>
</section>
